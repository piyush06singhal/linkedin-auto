# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Google Gemini AI (for content generation)
# Get your key from: https://makersuite.google.com/app/apikey
GOOGLE_AI_API_KEY=your_google_ai_api_key

# Hugging Face (Optional - for fallback when Gemini quota is exhausted)
# Get your key from: https://huggingface.co/settings/tokens
# Leave empty to use public access (works but slower)
HUGGINGFACE_API_KEY=

# LinkedIn
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/linkedin/callback
NEXT_PUBLIC_LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/linkedin/callback

# Cron Secret
CRON_SECRET=your-random-secret-key

# Email Service (Resend - for workspace invitations and notifications)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key
# Optional: Set custom sender email (requires domain verification in Resend)
# If not set, uses onboarding@resend.dev (test domain)
RESEND_FROM_EMAIL=LinkedAI <noreply@yourdomain.com>
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Image Generation
# Uses Gemini AI to enhance prompts + Pollinations.ai for free AI image generation
# Gemini API key is the same as GOOGLE_AI_API_KEY above
# No additional API keys needed - Pollinations.ai is completely free!
